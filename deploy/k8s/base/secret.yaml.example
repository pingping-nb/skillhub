# SkillHub Secret 配置
# 複製此檔案為 secret.yaml 並修改值
# cp secret.yaml.example secret.yaml

apiVersion: v1
kind: Secret
metadata:
  name: skillhub-secret
type: Opaque
stringData:
  # PostgreSQL 連線配置
  # 使用外部資料庫：修改主機地址和埠
  # 使用內建資料庫（overlays/with-infra）：保持 postgres:5432
  spring-datasource-url: jdbc:postgresql://postgres:5432/skillhub
  spring-datasource-username: skillhub
  spring-datasource-password: change-me

  # Redis 資料節點密碼（單機、Sentinel 與 Cluster 共用；無密碼時留空）
  redis-password: ""
  # Redis Sentinel 獨立密碼；與資料節點相同時也可填寫同一個值
  redis-sentinel-password: ""

  # Bootstrap 管理員密碼（敏感）
  bootstrap-admin-password: ChangeMe!2026

  # GitHub OAuth（可選，用於 GitHub 登入）
  oauth2-github-client-id: ""
  oauth2-github-client-secret: ""

  # LLM 配置（可選，用於技能掃描）
  skill-scanner-llm-api-key: ""
  skill-scanner-llm-base-url: ""
  skill-scanner-llm-model: ""

  # S3 儲存配置（可選，使用 S3/OSS 時配置）
  skillhub-storage-s3-access-key: ""
  skillhub-storage-s3-secret-key: ""
